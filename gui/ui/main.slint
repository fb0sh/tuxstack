import { VerticalBox, HorizontalBox, ListView, ScrollView, LineEdit } from "std-widgets.slint";

export struct ContainerData {
    id: string, name: string, image: string, status: string,
    created: string, ports: string, cpu: string, memory: string,
}
export struct ImageData { id: string, name: string, tag: string, size: string, created: string }
export struct LogEntry { timestamp: string, stream: string, message: string }
export struct SidebarItem { icon: string, label: string, group: string }

global TuxColors {
    in-out property <color> bg: #F6F6F7;
    in-out property <color> panel: #FFFFFF;
    in-out property <color> sidebar: #F0F0F1;
    in-out property <color> border: #E6E6E8;
    in-out property <color> text: #2B2B2B;
    in-out property <color> text_secondary: #8A8A8A;
    in-out property <color> accent: #A13BDA;
    in-out property <color> green: #22C55E;
    in-out property <color> red: #EF4444;
    in-out property <color> yellow: #F59E0B;
}

export global AppState {
    in-out property <int> selected_sidebar: 0;
    in-out property <int> current_module: 0;
    in-out property <[SidebarItem]> sidebar_items: [
        { icon: "□", label: "Containers", group: "Docker" },
        { icon: "▤", label: "Images", group: "Docker" },
        { icon: "▯", label: "Volumes", group: "Docker" },
        { icon: "◎", label: "Networks", group: "Docker" },
        { icon: "◇", label: "Instances", group: "Incus" },
        { icon: "○", label: "Activity", group: "General" },
        { icon: "⚡", label: "Commands", group: "General" },
    ];
    in-out property <[ContainerData]> containers: [];
    in-out property <int> selected_container: -1;
    in-out property <bool> containers_empty: true;
    in-out property <[ImageData]> images: [];
    in-out property <int> selected_image: -1;
    in-out property <bool> images_empty: true;
    in-out property <int> detail_tab: 0;
    in-out property <string> detail_name: "";
    in-out property <string> detail_status: "";
    in-out property <string> detail_image: "";
    in-out property <string> detail_created: "";
    in-out property <string> detail_ip: "";
    in-out property <string> detail_ports: "";
    in-out property <string> detail_cpu: "";
    in-out property <string> detail_memory: "";
    in-out property <string> stats_cpu_percent: "";
    in-out property <string> stats_memory_usage: "";
    in-out property <string> stats_memory_limit: "";
    in-out property <float> stats_cpu_value: 0.0;
    in-out property <float> stats_memory_value: 0.0;
    in-out property <string> stats_network_rx: "";
    in-out property <string> stats_network_tx: "";
    in-out property <string> stats_pids: "";
    in-out property <[LogEntry]> logs: [];
    in-out property <string> search_text: "";
    callback sidebar_selected(int);
    callback container_selected(int);
    callback tab_selected(int);
    callback refresh_requested();
    callback container_action(string, string);
    callback image_pull(string);
    callback image_remove(string);
    callback search_changed(string);
}

// ════ macOS-style pill button ═══════════════════════════════════

component PillButton {
    in property <string> text_content;
    in property <bool> primary;
    in property <length> min_w: 0px;
    callback pressed;
    height: 28px;

    Rectangle {
        min-width: min_w;
        border-radius: 6px;
        background: primary ? TuxColors.accent : transparent;
        border-width: primary ? 0px : 1px;
        border-color: primary ? TuxColors.accent : TuxColors.border;
        Text {
            text: text_content;
            color: primary ? #FFFFFF : TuxColors.text_secondary;
            font-size: 12px;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea { clicked => { pressed(); } }
    }
}

// ════ Toolbar icon button ═══════════════════════════════════════

component ToolbarButton {
    in property <string> icon_text;
    callback pressed;
    width: 30px; height: 30px;

    Rectangle {
        border-radius: 6px;
        background: #F6F6F7;
        Text {
            text: icon_text;
            color: TuxColors.text_secondary;
            font-size: 15px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea { clicked => { pressed(); } }
    }
}

// ════ Status badge ══════════════════════════════════════════════

component StatusBadge {
    in property <string> status_text;
    height: 22px;

    Rectangle {
        border-radius: 4px;
        background: status_text == "running" ? #ECFDF5 :
                   status_text == "paused" ? #FFFBEB : #FEF2F2;
        HorizontalBox {
            padding-left: 8px; padding-right: 8px;
            spacing: 4px;
            alignment: center;
            Rectangle {
                width: 7px; height: 7px;
                border-radius: 4px;
                background: status_text == "running" ? TuxColors.green :
                           status_text == "paused" ? TuxColors.yellow : TuxColors.red;
            }
            Text {
                text: status_text;
                font-size: 11px;
                color: status_text == "running" ? #065F46 :
                       status_text == "paused" ? #92400E : #991B1B;
            }
        }
    }
}

// ════ Field row ═════════════════════════════════════════════════

component FieldRow {
    in property <string> label;
    in property <string> value;
    height: 28px;

    HorizontalBox {
        spacing: 16px;
        Text { text: label; font-size: 12px; color: TuxColors.text_secondary; min-width: 80px; }
        Text { text: value; font-size: 13px; color: TuxColors.text; }
    }
}

// ════ Progress bar ═════════════════════════════════════════════

component StatBar {
    in property <string> label_text;
    in property <float> percent;
    height: 48px;

    VerticalBox { spacing: 6px;
        Text { text: label_text; font-size: 12px; color: TuxColors.text; }
        Rectangle {
            height: 8px; border-radius: 4px;
            background: TuxColors.border;
            Rectangle {
                width: parent.width * Math.min(percent, 1.0);
                height: 8px; border-radius: 4px;
                background: percent > 0.8 ? TuxColors.red : TuxColors.green;
            }
        }
    }
}

// ════ Segmented Control ════════════════════════════════════════

component SegmentedControl {
    in property <[string]> tabs: ["Info", "Stats", "Logs", "Terminal", "Files"];
    in-out property <int> selected: 0;
    callback toggled(int);
    height: 32px;

    HorizontalBox { spacing: 4px;
        for tab[idx] in tabs: Rectangle {
            min-width: 72px;
            height: 32px;
            border-radius: 6px;
            background: idx == selected ? TuxColors.accent : transparent;
            Text {
                text: tab;
                color: idx == selected ? #FFFFFF : TuxColors.text_secondary;
                font-size: 12px;
                font-weight: 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea { clicked => { selected = idx; toggled(idx); } }
        }
    }
}

// ════ Sidebar ══════════════════════════════════════════════════

component Sidebar {
    Rectangle {
        width: 210px;
        background: TuxColors.sidebar;

        VerticalBox { padding-top: 16px; spacing: 2px;

            for item[idx] in AppState.sidebar_items: Rectangle {
                height: 36px;
                border-radius: 8px;
                background: idx == AppState.selected_sidebar ? TuxColors.accent : transparent;
                HorizontalBox { padding-left: 16px; padding-right: 16px; spacing: 10px; alignment: start;
                    Text {
                        text: item.icon;
                        color: idx == AppState.selected_sidebar ? #FFFFFF : TuxColors.text_secondary;
                        font-size: 15px;
                        min-width: 20px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: item.label;
                        color: idx == AppState.selected_sidebar ? #FFFFFF : TuxColors.text;
                        font-size: 13px;
                        font-weight: idx == AppState.selected_sidebar ? 600 : 400;
                    }
                }
                TouchArea {
                    clicked => { AppState.selected_sidebar = idx; AppState.sidebar_selected(idx); }
                }
            }

            Rectangle { height: 0px; }

            Rectangle {
                height: 44px;
                border-radius: 8px;
                HorizontalBox { padding-left: 16px; spacing: 10px; alignment: start;
                    Rectangle { width: 22px; height: 22px; border-radius: 11px; background: TuxColors.accent;
                        Text { text: "U"; color: #FFFFFF; font-size: 11px; font-weight: 700;
                            horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "fb0sh"; color: TuxColors.text_secondary; font-size: 13px; }
                }
            }
        }
    }
}

// ════ Container List Item ══════════════════════════════════════

component ContainerListItem {
    in property <ContainerData> data;
    in property <bool> active;
    callback clicked;
    callback action(string);
    height: 72px;

    Rectangle {
        background: active ? #F5F3F7 : transparent;
        VerticalBox { spacing: 0px;
            Rectangle {
                height: 71px;
                VerticalBox { padding-left: 14px; padding-right: 10px; padding-top: 12px; spacing: 8px;

                    // Row 1: name + status badge
                    HorizontalBox { spacing: 10px; alignment: start;
                        Text { text: data.name; font-size: 14px; font-weight: 600; color: TuxColors.text; }
                        StatusBadge { status_text: data.status; }
                    }

                    // Row 2: image cpu memory + actions
                    HorizontalBox { spacing: 16px; alignment: start;
                        Text { text: data.image; font-size: 12px; color: TuxColors.text_secondary; }
                        Text { text: data.cpu; font-size: 12px; color: TuxColors.text_secondary; }
                        Text { text: data.memory; font-size: 12px; color: TuxColors.text_secondary; }
                        Rectangle { width: 0px; }
                        if (data.status != "running") : PillButton { text_content: "启动"; primary: true; min_w: 44px; pressed => { action("start"); } }
                        if (data.status == "running") : PillButton { text_content: "停止"; primary: false; min_w: 44px; pressed => { action("stop"); } }
                        if (data.status == "running") : PillButton { text_content: "重启"; primary: false; min_w: 44px; pressed => { action("restart"); } }
                        PillButton { text_content: "删除"; primary: false; min_w: 44px; pressed => { action("remove"); } }
                    }
                }
                TouchArea { clicked => { clicked(); } }
            }
            Rectangle { height: 1px; background: TuxColors.border; }
        }
    }
}

// ════ Image List Item ═══════════════════════════════════════════

component ImageListItem {
    in property <ImageData> data;
    in property <bool> active;
    callback clicked;
    height: 52px;

    Rectangle {
        background: active ? #F5F3F7 : transparent;
        VerticalBox { spacing: 0px;
            Rectangle {
                height: 51px;
                VerticalBox { padding-left: 14px; padding-right: 14px; spacing: 4px; padding-top: 8px;
                    Text { text: data.name; font-size: 13px; font-weight: 600; color: TuxColors.text; }
                    HorizontalBox { spacing: 16px;
                        Text { text: data.tag; font-size: 12px; color: TuxColors.text_secondary; }
                        Text { text: data.size; font-size: 12px; color: TuxColors.text_secondary; }
                    }
                }
                TouchArea { clicked => { clicked(); } }
            }
            Rectangle { height: 1px; background: TuxColors.border; }
        }
    }
}

// ════ Empty State ══════════════════════════════════════════════

component EmptyState {
    VerticalBox { alignment: center; spacing: 12px;
        Text { text: "📦"; font-size: 48px; horizontal-alignment: center; }
        Text { text: "No Containers"; font-size: 16px; color: TuxColors.text_secondary; horizontal-alignment: center; }
        Rectangle { height: 12px; }
        Rectangle { border-radius: 10px; background: TuxColors.bg; height: 60px; width: 280px;
            Text { text: "docker run -it -p 80:80 docker/getting-started"; font-size: 12px;
                color: TuxColors.text_secondary; wrap: word-wrap;
                horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}

// ════ Detail tab content panels ════════════════════════════════

component NoSelection {
    VerticalBox { alignment: center;
        Text { text: "No Selection"; font-size: 28px; color: #C8C8C8; horizontal-alignment: center; }
    }
}

component DetailInfoContent {
    VerticalBox { padding: 28px; spacing: 24px;
        Text { text: AppState.detail_name; font-size: 20px; font-weight: 700; color: TuxColors.text; }
        Rectangle { height: 1px; background: TuxColors.border; }
        VerticalBox { spacing: 14px;
            FieldRow { label: "Status"; value: AppState.detail_status; }
            FieldRow { label: "Image"; value: AppState.detail_image; }
            FieldRow { label: "Created"; value: AppState.detail_created; }
            FieldRow { label: "IP"; value: AppState.detail_ip; }
            FieldRow { label: "Ports"; value: AppState.detail_ports; }
            FieldRow { label: "CPU"; value: AppState.detail_cpu; }
            FieldRow { label: "Memory"; value: AppState.detail_memory; }
        }
    }
}

component DetailStatsContent {
    VerticalBox { padding: 28px; spacing: 24px;
        Text { text: "Resource Usage"; font-size: 15px; font-weight: 600; color: TuxColors.text; }
        StatBar { label_text: "CPU  " + AppState.stats_cpu_percent; percent: AppState.stats_cpu_value; }
        StatBar { label_text: "Memory  " + AppState.stats_memory_usage + " / " + AppState.stats_memory_limit; percent: AppState.stats_memory_value; }
        Rectangle { height: 1px; background: TuxColors.border; }
        Text { text: "Network I/O"; font-size: 15px; font-weight: 600; color: TuxColors.text; }
        FieldRow { label: "Received"; value: AppState.stats_network_rx; }
        FieldRow { label: "Sent"; value: AppState.stats_network_tx; }
        Rectangle { height: 1px; background: TuxColors.border; }
        FieldRow { label: "PIDs"; value: AppState.stats_pids; }
    }
}

component DetailLogsContent {
    Rectangle { border-radius: 10px; background: #1A1A1A; clip: true;
        ScrollView {
            VerticalBox { padding: 16px; spacing: 2px;
                for log in AppState.logs: HorizontalBox { spacing: 8px;
                    Text { text: log.timestamp; color: #6B7280; font-size: 11px;
                        font-family: "monospace"; min-width: 56px; }
                    Text { text: log.stream == "stderr" ? "⚠" : " "; color: #EF4444; font-size: 11px; min-width: 12px; }
                    Text { text: log.message; color: log.stream == "stderr" ? #FCA5A5 : #D1D5DB;
                        font-size: 12px; font-family: "monospace"; wrap: word-wrap; }
                }
                if (AppState.logs.length == 0) : VerticalBox { padding: 8px;
                    Text { text: "No logs"; color: #6B7280; font-size: 12px; } }
            }
        }
    }
}

component DetailTerminalContent {
    Rectangle { border-radius: 10px; background: #1A1A1A;
        Text { text: "Terminal coming soon"; color: #6B7280; font-size: 14px;
            horizontal-alignment: center; vertical-alignment: center; }
    }
}

component DetailFilesContent {
    Rectangle { border-radius: 10px; background: TuxColors.bg;
        Text { text: "File browser coming soon"; color: TuxColors.text_secondary; font-size: 14px;
            horizontal-alignment: center; vertical-alignment: center; }
    }
}

// ════ Detail Panel ═════════════════════════════════════════════

component DetailPanel {
    Rectangle { background: TuxColors.panel;
        VerticalBox { spacing: 0px;

            Rectangle {
                height: 48px;
                VerticalBox { spacing: 0px;
                    HorizontalBox { padding: 10px; alignment: center; height: 47px;
                        SegmentedControl { tabs: ["Info", "Stats", "Logs", "Terminal", "Files"]; selected: AppState.detail_tab; toggled(idx) => { AppState.detail_tab = idx; AppState.tab_selected(idx); } }
                    }
                    Rectangle { height: 1px; background: TuxColors.border; }
                }
            }

            if (AppState.selected_container == -1) : NoSelection { }
            if (AppState.selected_container >= 0 && AppState.detail_tab == 0) : DetailInfoContent { }
            if (AppState.selected_container >= 0 && AppState.detail_tab == 1) : DetailStatsContent { }
            if (AppState.selected_container >= 0 && AppState.detail_tab == 2) : DetailLogsContent { }
            if (AppState.selected_container >= 0 && AppState.detail_tab == 3) : DetailTerminalContent { }
            if (AppState.selected_container >= 0 && AppState.detail_tab == 4) : DetailFilesContent { }
        }
    }
}

// ════ Container & Image list views ═════════════════════════════

component ContainerListView {
    ListView {
        for container[idx] in AppState.containers: ContainerListItem {
            data: container;
            active: idx == AppState.selected_container;
            clicked => { AppState.selected_container = idx; AppState.container_selected(idx); }
            action(a) => { AppState.container_action(container.id, a); }
        }
    }
}

component ImageListView {
    ListView {
        for image[idx] in AppState.images: ImageListItem {
            data: image;
            active: idx == AppState.selected_image;
            clicked => { AppState.selected_image = idx; }
        }
    }
}

// ════ Toolbar + Resource List ═════════════════════════════════

component ResourceList {
    Rectangle { width: 340px; background: TuxColors.panel;
        VerticalBox { spacing: 0px;

            Rectangle {
                height: 44px;
                VerticalBox { spacing: 0px;
                    HorizontalBox { padding-left: 12px; padding-right: 12px; spacing: 8px; alignment: start; height: 43px;
                        ToolbarButton { icon_text: "↕"; pressed => { } }
                        Rectangle { width: 180px; height: 30px; border-radius: 7px; background: TuxColors.bg; border-width: 1px; border-color: TuxColors.border;
                            LineEdit { placeholder-text: "Search..."; font-size: 12px; text <=> AppState.search_text; height: 28px; width: 170px; }
                        }
                        Rectangle { width: 0px; }
                        Rectangle { width: 30px; height: 30px; border-radius: 15px; background: TuxColors.accent;
                            Text { text: "+"; color: #FFFFFF; font-size: 18px; font-weight: 300; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { } }
                        }
                    }
                    Rectangle { height: 1px; background: TuxColors.border; }
                }
            }

            if (AppState.current_module == 0 && AppState.containers_empty) : EmptyState { }
            if (AppState.current_module == 0 && !AppState.containers_empty) : ContainerListView { }
            if (AppState.current_module == 1) : ImageListView { }
            if (AppState.current_module == 2) : Rectangle { VerticalBox { padding: 24px; Text { text: "Volumes"; color: TuxColors.text_secondary; font-size: 13px; } } }
            if (AppState.current_module == 3) : Rectangle { VerticalBox { padding: 24px; Text { text: "Networks"; color: TuxColors.text_secondary; font-size: 13px; } } }
            if (AppState.current_module == 4) : Rectangle { VerticalBox { padding: 24px; Text { text: "Incus Instances"; color: TuxColors.text_secondary; font-size: 13px; } } }
        }
    }
}

// ════ Main Window ═════════════════════════════════════════════

export component MainWindow inherits Window {
    title: "tuxstack";
    preferred-width: 1100px;
    preferred-height: 720px;
    background: TuxColors.bg;

    HorizontalBox { spacing: 0px;
        Sidebar { }
        Rectangle { width: 1px; background: TuxColors.border; }
        ResourceList { }
        Rectangle { width: 1px; background: TuxColors.border; }
        DetailPanel { }
    }
}
