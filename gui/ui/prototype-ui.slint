// PROTOTYPE — throwaway UI variants for tuxstack main panel.
// Switch between A / B / C using ← → or the bottom bar.
// Will be deleted after the winning variant is chosen.

import { VerticalBox, HorizontalBox, Button, ListView, TabWidget, LineEdit } from "std-widgets.slint";

export struct ContainerData {
    name: string,
    image: string,
    status: string,
    cpu: string,
    memory: string,
    ports: string,
}

export global AppState {
    in-out property <[ContainerData]> containers: [];
    in-out property <int> variant_index: 0;
    callback switch_variant(int);
}

// ── Shared components ──────────────────────────────────────────────

component StatusDot {
    in property <string> status;
    Rectangle {
        width: 10px; height: 10px;
        border-radius: 5px;
        background: status == "running" ? #22c55e : #ef4444;
    }
}

component ContainerRow {
    in property <ContainerData> data;
    height: 48px;

    HorizontalBox {
        padding-left: 12px; padding-right: 12px;
        alignment: start;
        spacing: 8px;

        StatusDot { status: data.status; }

        Text { text: data.name; min-width: 120px; font-weight: 600; }
        Text { text: data.image; min-width: 140px; color: #64748b; }
        Text { text: data.status; min-width: 70px;
            color: data.status == "running" ? #16a34a : #dc2626;
        }
        Text { text: data.cpu; min-width: 60px; }
        Text { text: data.memory; min-width: 80px; }
        Text { text: data.ports; min-width: 80px; color: #64748b; }
    }
}

// ── VARIANT A: Tab-focused ──────────────────────────────────────────

component VariantA {
    VerticalBox {
        padding: 8px;
        spacing: 12px;

        // Top bar with tabs
        HorizontalBox {
            spacing: 4px;
            Rectangle {
                height: 32px; width: 100px;
                border-radius: 6px;
                background: #e2e8f0;
                Text { text: " 容器"; vertical-alignment: center; horizontal-alignment: center; }
            }
            Rectangle {
                height: 32px; width: 100px;
                border-radius: 6px;
                Text { text: " 镜像"; vertical-alignment: center; horizontal-alignment: center; color: #94a3b8; }
            }
            Rectangle {
                height: 32px; width: 120px;
                border-radius: 6px;
                Text { text: " Compose"; vertical-alignment: center; horizontal-alignment: center; color: #94a3b8; }
            }
            Rectangle { width: 0px; }
            Button { text: "刷新"; }
            Button { text: "+ 创建"; }
        }

        // Table header
        Rectangle { height: 28px; background: #f8fafc;
            HorizontalBox {
                padding-left: 12px; padding-right: 12px;
                Text { text: "名称"; font-weight: 700; min-width: 120px; color: #475569; font-size: 12px; }
                Text { text: "镜像"; font-weight: 700; min-width: 140px; color: #475569; font-size: 12px; }
                Text { text: "状态"; font-weight: 700; min-width: 70px; color: #475569; font-size: 12px; }
                Text { text: "CPU"; font-weight: 700; min-width: 60px; color: #475569; font-size: 12px; }
                Text { text: "内存"; font-weight: 700; min-width: 80px; color: #475569; font-size: 12px; }
                Text { text: "端口"; font-weight: 700; min-width: 80px; color: #475569; font-size: 12px; }
            }
        }

        // Container list
        ListView {
            for container in AppState.containers: ContainerRow {
                data: container;
            }
        }
    }
}

// ── VARIANT B: Dashboard-first ──────────────────────────────────────

component VariantB {
    VerticalBox {
        padding: 12px;
        spacing: 16px;

        // Overview cards
        HorizontalBox {
            spacing: 12px;

            Rectangle {
                height: 100px; width: 200px;
                border-radius: 12px;
                background: #1e293b;
                VerticalBox {
                    padding: 16px; spacing: 8px;
                    Text { text: "运行中容器"; color: #94a3b8; font-size: 12px; }
                    HorizontalBox {
                        Text { text: "3"; font-size: 36px; font-weight: 700; color: #22c55e; }
                        Text { text: " / 4"; font-size: 18px; color: #475569; vertical-alignment: bottom; }
                    }
                }
            }
            Rectangle {
                height: 100px; width: 200px;
                border-radius: 12px;
                background: #1e293b;
                VerticalBox {
                    padding: 16px; spacing: 8px;
                    Text { text: "资源使用"; color: #94a3b8; font-size: 12px; }
                    VerticalBox {
                        spacing: 4px;
                        Text { text: "CPU  2.6%"; font-size: 14px; color: #e2e8f0; }
                        Text { text: "内存  184 MB / 8 GB"; font-size: 14px; color: #e2e8f0; }
                    }
                }
            }
            Rectangle {
                height: 100px; width: 200px;
                border-radius: 12px;
                background: #1e293b;
                VerticalBox {
                    padding: 16px; spacing: 8px;
                    Text { text: "Incus 实例"; color: #94a3b8; font-size: 12px; }
                    Text { text: "未连接"; font-size: 14px; color: #64748b; }
                }
            }
        }

        // Search + action bar
        HorizontalBox {
            spacing: 8px;
            LineEdit {
                placeholder-text: "搜索容器...";
                width: 300px;
            }
            Rectangle { width: 0px; }
            Button { text: "刷新"; }
        }

        // Section header
        Text { text: "最近活动"; font-size: 16px; font-weight: 700; }

        // Container list (compact)
        ListView {
            for container in AppState.containers: ContainerRow {
                data: container;
            }
        }
    }
}

// ── VARIANT C: Sidebar nav ──────────────────────────────────────────

component VariantC {
    HorizontalBox {
        // Sidebar
        Rectangle {
            width: 60px;
            background: #1e293b;
            VerticalBox {
                padding-top: 16px;
                alignment: center;
                spacing: 16px;

                Rectangle {
                    width: 40px; height: 40px;
                    border-radius: 10px;
                    background: #3b82f6;
                    Text { text: "D"; color: white; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    width: 40px; height: 40px;
                    border-radius: 10px;
                    Text { text: "I"; color: #64748b; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    width: 40px; height: 40px;
                    border-radius: 10px;
                    Text { text: "C"; color: #64748b; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    width: 0px; height: 0px;
                }
                Rectangle {
                    width: 40px; height: 40px;
                    border-radius: 10px;
                    Text { text: "⚙"; color: #475569; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }

        // Main content
        Rectangle {
            background: #f8fafc;
            VerticalBox {
                padding: 16px;
                spacing: 12px;

                // Breadcrumb + actions
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "容器"; font-size: 24px; font-weight: 700; color: #0f172a; }
                    Rectangle { width: 0px; }
                    Button { text: "+ 启动"; }
                    Button { text: "刷新"; }
                }

                // Quick stats bar
                HorizontalBox {
                    spacing: 16px;
                    Text { text: "● 3 运行中"; color: #16a34a; }
                    Text { text: "● 1 已停止"; color: #dc2626; }
                    Text { text: "CPU 2.6%"; color: #475569; }
                    Text { text: "内存 184 MB"; color: #475569; }
                }

                // Container list with header
                Rectangle { height: 28px; background: #e2e8f0; border-radius: 6px;
                    HorizontalBox {
                        padding-left: 12px; padding-right: 12px;
                        Text { text: "名称"; font-weight: 700; min-width: 120px; color: #475569; font-size: 12px; }
                        Text { text: "镜像"; font-weight: 700; min-width: 140px; color: #475569; font-size: 12px; }
                        Text { text: "状态"; font-weight: 700; min-width: 70px; color: #475569; font-size: 12px; }
                        Text { text: "CPU"; font-weight: 700; min-width: 60px; color: #475569; font-size: 12px; }
                        Text { text: "内存"; font-weight: 700; min-width: 80px; color: #475569; font-size: 12px; }
                    }
                }

                ListView {
                    for container in AppState.containers: ContainerRow {
                        data: container;
                    }
                }
            }
        }
    }
}

// ── Main window ─────────────────────────────────────────────────────

export component AppWindow inherits Window {
    title: "tuxstack — UI Prototype";
    preferred-width: 960px;
    preferred-height: 680px;

    VerticalBox {
        // Show current variant label
        HorizontalBox {
            height: 0px; // hidden; variant label shown in switcher bar
        }

        if (AppState.variant_index == 0) : VariantA { }
        if (AppState.variant_index == 1) : VariantB { }
        if (AppState.variant_index == 2) : VariantC { }
    }

    // Floating bottom switcher bar
    Rectangle {
        x: (parent.width - 280px) / 2;
        y: parent.height - 48px;
        width: 280px; height: 36px;
        border-radius: 18px;
        background: #334155;
        drop-shadow-offset-x: 0px;
        drop-shadow-offset-y: 2px;
        drop-shadow-blur: 8px;
        drop-shadow-color: rgba(0, 0, 0, 0.3);

        HorizontalBox {
            padding-left: 8px; padding-right: 8px;
            alignment: center;
            spacing: 4px;

            Button {
                text: "◀";
                width: 36px; height: 28px;
                clicked => {
                    AppState.variant_index = Math.mod(AppState.variant_index - 1 + 3, 3);
                }
            }

            Text {
                text: (AppState.variant_index == 0 ? "A — 标签页" :
                       AppState.variant_index == 1 ? "B — 仪表盘" :
                       "C — 侧边栏");
                color: white;
                font-size: 13px;
                min-width: 150px;
                horizontal-alignment: center;
            }

            Button {
                text: "▶";
                width: 36px; height: 28px;
                clicked => {
                    AppState.variant_index = Math.mod(AppState.variant_index + 1, 3);
                }
            }
        }
    }

    // Keyboard handler (forwarded from Rust)
    callback handle_key(string);
    handle_key(key) => {
        if (key == "Left") {
            AppState.variant_index = Math.mod(AppState.variant_index - 1 + 3, 3);
        } else if (key == "Right") {
            AppState.variant_index = Math.mod(AppState.variant_index + 1, 3);
        }
    }
}
